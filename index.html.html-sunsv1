<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101010">
  <meta name="description" content="SUNS — premium footwear designed to keep you moving.">
  <title>SUNS® — Keep Moving</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#101010;--panel:#171717;--panel-2:#1e1e1e;--ink:#f4f2ed;--muted:#9b9a95;--line:rgba(255,255,255,.12);--accent:#ff5a2a;--accent-soft:#ff865f;--mono:'DM Mono',monospace;--sans:'Manrope',Arial,sans-serif;--nav-h:82px;--ease:cubic-bezier(.22,.8,.24,1)}
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:100px}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
    body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(ellipse at 80% 12%,rgba(255,90,42,.08),transparent 31%),linear-gradient(115deg,rgba(255,255,255,.015),transparent 45%)}
    a{color:inherit;text-decoration:none}
    button,input{font:inherit}
    button{color:inherit}
    img{display:block;max-width:100%}
    ::selection{background:var(--accent);color:#100e0c}
    .page-progress{position:fixed;top:0;left:0;width:0%;height:2px;background:var(--accent);z-index:1000;box-shadow:0 0 14px rgba(255,90,42,.55)}
    .container{width:min(1440px,calc(100% - 88px));margin-inline:auto}
    .eyebrow{display:flex;align-items:center;gap:10px;font:11px/1.4 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#b9b8b2}
    .eyebrow::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(255,90,42,.35)}
    .section{padding:132px 0}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:48px}
    .section-kicker{font:11px var(--mono);letter-spacing:.16em;color:var(--muted);text-transform:uppercase;margin-bottom:17px}
    h1,h2,h3,p{margin-top:0}
    h1,h2,h3{letter-spacing:-.075em}
    h2{font-size:clamp(42px,6.2vw,88px);line-height:.91;margin:0;font-weight:800}
    .body-copy{font-size:15px;line-height:1.8;color:#b8b7b1;max-width:440px}
    .mono{font-family:var(--mono)}
    .pill{display:inline-flex;align-items:center;gap:10px;padding:10px 13px;border:1px solid var(--line);border-radius:99px;font:10px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#d7d5cf}
    .pill span{width:6px;height:6px;border-radius:50%;background:var(--accent)}
    .button{display:inline-flex;align-items:center;justify-content:center;gap:22px;border:1px solid var(--accent);background:var(--accent);color:#17110e;min-height:52px;padding:0 20px;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;transition:background .25s ease,color .25s ease,border-color .25s ease,transform .25s ease;cursor:pointer}
    .button:hover{background:transparent;color:var(--accent);transform:translateY(-2px)}
    .button .arrow{font-size:18px;line-height:0;transition:transform .25s ease}
    .button:hover .arrow{transform:translate(3px,-2px)}
    .button--ghost{background:transparent;border-color:var(--line);color:var(--ink)}
    .button--ghost:hover{border-color:var(--accent);color:var(--accent)}

    /* Navigation */
    .site-nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);z-index:100;display:flex;align-items:center;transition:background .35s ease,border-color .35s ease,backdrop-filter .35s ease;height:82px;border-bottom:1px solid transparent}
    .site-nav.is-scrolled{background:rgba(16,16,16,.7);backdrop-filter:blur(18px) saturate(145%);-webkit-backdrop-filter:blur(18px) saturate(145%);border-bottom-color:rgba(255,255,255,.09)}
    .nav-inner{width:min(1440px,calc(100% - 88px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:32px}
    .brand{display:inline-flex;align-items:center;gap:10px;font-size:25px;font-weight:800;letter-spacing:-.09em}
    .brand-mark{position:relative;width:20px;height:20px;border:2px solid var(--accent);border-radius:50%;display:inline-block;box-shadow:0 0 18px rgba(255,90,42,.12)}
    .brand-mark::before{content:"";position:absolute;width:9px;height:2px;right:-4px;top:7px;background:var(--accent);transform:rotate(-45deg);border-radius:4px}
    .brand-mark::after{content:"";position:absolute;width:3px;height:3px;background:var(--accent);border-radius:50%;left:6px;top:6px}
    .nav-links{display:flex;align-items:center;gap:clamp(22px,3vw,48px);margin-left:auto;margin-right:20px}
    .nav-links a{position:relative;font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:#b9b8b3;transition:color .2s ease}
    .nav-links a::after{content:"";position:absolute;left:0;right:100%;bottom:-8px;height:1px;background:var(--accent);transition:right .25s ease}
    .nav-links a:hover,.nav-links a.active{color:var(--ink)}
    .nav-links a:hover::after,.nav-links a.active::after{right:0}
    .nav-actions{display:flex;align-items:center;gap:18px}
    .bag-button{position:relative;display:flex;align-items:center;gap:9px;background:none;border:0;cursor:pointer;font:10px var(--mono);letter-spacing:.11em;text-transform:uppercase;padding:8px 0}
    .bag-button svg{width:18px;height:18px;stroke:var(--ink);fill:none;stroke-width:1.5}
    .bag-count{display:inline-grid;place-items:center;min-width:17px;height:17px;border-radius:50%;background:var(--accent);color:#111;font:10px var(--mono);padding:0 4px}
    .menu-toggle{display:none;background:transparent;border:1px solid var(--line);width:42px;height:42px;align-items:center;justify-content:center;cursor:pointer}
    .menu-toggle svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6}

    /* Hero */
    .hero{height:100svh;min-height:100svh;display:flex;align-items:center;position:relative;padding:var(--nav-h) 0 82px;isolation:isolate;overflow:hidden}
    .hero::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 78% 44%,rgba(255,90,42,.075),transparent 34%),linear-gradient(90deg,rgba(255,255,255,.018),transparent 56%)}
    .hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,.96fr) minmax(0,1.04fr);align-items:center;gap:clamp(10px,2vw,32px)}
    .hero-copy{position:relative;z-index:5;padding:0 0 12px}
    .hero .eyebrow{margin-bottom:29px}
    .hero h1{font-size:clamp(68px,8.15vw,126px);line-height:.82;font-weight:800;letter-spacing:-.105em;margin:0 0 28px;max-width:760px;white-space:nowrap}
    .hero h1 .accent{color:var(--accent);display:inline-block}
    .hero-sub{display:flex;align-items:flex-end;gap:28px;max-width:480px}
    .hero-sub p{max-width:395px;color:#aaa9a3;font-size:14px;line-height:1.8;margin:0}
    .hero-links{display:flex;align-items:center;gap:12px;margin-top:31px;flex-wrap:wrap}
    .hero-meta{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-top:48px;padding-top:15px;border-top:1px solid var(--line);max-width:545px;font:9px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:#777670}
    .hero-meta strong{font-weight:400;color:#d0cec8}
    .hero-art{position:relative;height:min(74vh,730px);min-height:0;display:flex;align-items:center;justify-content:center;margin-right:-2vw;perspective:1200px}
    .hero-orbit{position:absolute;width:min(46vw,650px);aspect-ratio:1;border:1px solid rgba(255,255,255,.115);border-radius:50%;transform:rotate(-25deg);animation:orbit-turn 36s linear infinite}
    .hero-orbit::before,.hero-orbit::after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.07)}
    .hero-orbit::before{inset:8%}.hero-orbit::after{inset:18%}
    .hero-disc{position:absolute;width:83%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 48% 46%,rgba(255,90,42,.20) 0%,rgba(255,90,42,.085) 27%,rgba(255,90,42,.025) 51%,transparent 70%);filter:blur(13px);opacity:1;transform:translate(2%,2%)}
    .hero-shoe-wrap{position:relative;z-index:2;width:min(100%,680px);height:100%;display:grid;place-items:center;transform-style:preserve-3d;transform-origin:50% 55%;filter:drop-shadow(0 32px 34px rgba(0,0,0,.36));animation:shoe-float 6.8s ease-in-out infinite;will-change:transform}
    .hero-shoe{display:block;width:100%;height:100%;max-width:680px;object-fit:contain;object-position:center;transform-origin:52% 54%;transform-style:preserve-3d;backface-visibility:hidden;filter:contrast(1.12) saturate(1.06);animation:shoe-rotate 13s ease-in-out infinite;will-change:transform}
    .hero-tag{position:absolute;z-index:4;right:2%;top:17%;display:flex;align-items:center;gap:10px;writing-mode:vertical-rl;font:9px var(--mono);letter-spacing:.19em;text-transform:uppercase;color:#d2d0ca}
    .hero-tag::before{content:"";width:1px;height:40px;background:var(--accent)}
    .hero-stamp{position:absolute;bottom:10%;right:1%;z-index:3;width:86px;height:86px;border:1px solid rgba(255,255,255,.25);border-radius:50%;display:grid;place-items:center;text-align:center;color:#dad8d2;font:8px/1.6 var(--mono);letter-spacing:.08em;transform:rotate(12deg)}
    .hero-stamp b{display:block;font-size:15px;color:var(--accent);font-weight:500}
    .scroll-cue{position:absolute;z-index:8;bottom:19px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;font:9px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#777670;white-space:nowrap;transition:color .2s ease}
    .scroll-cue:hover{color:var(--ink)}
    .scroll-cue-icon{width:42px;height:42px;border:1px solid rgba(255,90,42,.78);border-radius:50%;display:grid;place-items:center;color:var(--accent);animation:scroll-pulse 1.9s ease-in-out infinite}
    .scroll-cue-icon svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .scroll-cue-text{font-size:8px;letter-spacing:.2em}
    @keyframes shoe-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-16px,0)}}
    @keyframes shoe-rotate{0%,100%{transform:perspective(1000px) rotateY(-14deg) rotateZ(-4deg) rotateX(1deg)}25%{transform:perspective(1000px) rotateY(-5deg) rotateZ(-1deg) rotateX(0deg)}50%{transform:perspective(1000px) rotateY(13deg) rotateZ(3deg) rotateX(-1deg)}75%{transform:perspective(1000px) rotateY(3deg) rotateZ(0deg) rotateX(1deg)}}
    @keyframes orbit-turn{from{transform:rotate(-25deg)}to{transform:rotate(335deg)}}
    @keyframes scroll-pulse{0%,100%{transform:translateY(0) scale(1);box-shadow:0 0 0 0 rgba(255,90,42,.23)}50%{transform:translateY(4px) scale(1.04);box-shadow:0 0 0 10px rgba(255,90,42,0)}}

    /* Moving line */
    .marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#151515;padding:19px 0}
    .marquee-track{display:flex;width:max-content;animation:marquee 35s linear infinite;align-items:center;gap:26px}
    .marquee-item{display:flex;align-items:center;gap:26px;font-size:clamp(20px,3vw,39px);font-weight:800;letter-spacing:-.055em;text-transform:uppercase;white-space:nowrap;color:#dedcd6}
    .marquee-item i{font-style:normal;color:var(--accent);font-size:.7em}
    @keyframes marquee{to{transform:translateX(-50%)}}

    /* Collection */
    .collection{background:#121212}
    .collection .section-head{align-items:flex-end}
    .collection-intro{max-width:260px;color:var(--muted);font-size:12px;line-height:1.8;margin:0 0 5px}
    .product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
    .product-card{background:#191919;position:relative;overflow:hidden;min-width:0;border:1px solid rgba(255,255,255,.065);transition:border-color .3s ease,transform .3s ease}
    .product-card:hover{border-color:rgba(255,90,42,.5);transform:translateY(-5px)}
    .product-image{height:390px;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 38%,#34322f 0%,#20201f 48%,#181818 76%)}
    .product-image::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(18,18,18,.5),transparent 40%);pointer-events:none}
    .product-image img{height:100%;width:100%;object-fit:cover;opacity:.93;mix-blend-mode:screen;transition:transform .7s var(--ease),opacity .35s ease}
    .product-card:hover .product-image img{transform:scale(1.08) rotate(-2deg);opacity:1}
    .product-index{position:absolute;top:18px;left:18px;z-index:2;font:10px var(--mono);letter-spacing:.12em;color:#dbd9d3}
    .product-tag{position:absolute;top:16px;right:16px;z-index:2;padding:7px 9px;background:var(--accent);color:#16100e;font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}
    .product-info{padding:22px 22px 20px}
    .product-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}
    .product-title{font-size:22px;letter-spacing:-.055em;margin:0 0 6px;font-weight:800}
    .product-type{font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#8b8982}
    .product-price{font:13px var(--mono);white-space:nowrap;color:#e1dfd9}
    .product-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px;padding-top:15px;border-top:1px solid var(--line)}
    .swatches{display:flex;gap:6px}
    .swatch{width:12px;height:12px;border-radius:50%;border:1px solid rgba(255,255,255,.25)}
    .swatch--cream{background:#d8d2c5}.swatch--orange{background:#ff5a2a}.swatch--black{background:#3e3d3b}.swatch--blue{background:#3c5269}
    .quick-add{border:0;background:transparent;cursor:pointer;font:10px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:#d7d5cf;display:flex;align-items:center;gap:9px;padding:7px 0;transition:color .2s ease}
    .quick-add span{font-size:18px;color:var(--accent);transition:transform .2s ease}
    .quick-add:hover{color:var(--accent)}.quick-add:hover span{transform:translate(3px,-2px)}
    .collection-foot{margin-top:26px;display:flex;justify-content:space-between;align-items:center;color:#777670;font:10px var(--mono);letter-spacing:.11em;text-transform:uppercase}
    .text-link{display:inline-flex;align-items:center;gap:12px;color:var(--ink);font:10px var(--mono);letter-spacing:.12em;text-transform:uppercase;border-bottom:1px solid var(--accent);padding-bottom:8px;transition:color .2s ease}
    .text-link:hover{color:var(--accent)}

    /* Technology */
    .technology{position:relative;overflow:hidden}
    .tech-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(45px,8vw,120px)}
    .tech-visual{position:relative;min-height:610px;background:#1a1a1a;overflow:hidden;border:1px solid var(--line)}
    .tech-visual::before{content:"";position:absolute;width:80%;aspect-ratio:1;left:10%;top:8%;border-radius:50%;background:radial-gradient(circle,rgba(255,90,42,.22),transparent 69%)}
    .tech-visual::after{content:"";position:absolute;inset:0;background:linear-gradient(130deg,transparent 22%,rgba(255,255,255,.035) 22.2%,transparent 22.6%),linear-gradient(40deg,transparent 68%,rgba(255,255,255,.04) 68.2%,transparent 68.5%);pointer-events:none}
    .tech-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;mix-blend-mode:screen;opacity:.82;transform:scale(1.05);filter:contrast(1.1) saturate(.75)}
    .tech-number{position:absolute;left:24px;top:24px;z-index:2;font:10px var(--mono);letter-spacing:.15em;color:#cbc9c3}
    .tech-caption{position:absolute;z-index:2;bottom:24px;left:24px;right:24px;display:flex;align-items:end;justify-content:space-between;gap:24px}
    .tech-caption b{font-size:clamp(24px,3vw,39px);line-height:.95;letter-spacing:-.07em;max-width:220px}
    .tech-caption span{font:10px var(--mono);color:#b1afa9;letter-spacing:.11em;text-transform:uppercase;text-align:right}
    .tech-copy h2{margin-bottom:28px}
    .tech-copy .body-copy{margin-bottom:32px}
    .feature-list{border-top:1px solid var(--line);margin-top:42px}
    .feature{display:grid;grid-template-columns:46px 1fr auto;align-items:center;gap:18px;padding:19px 0;border-bottom:1px solid var(--line)}
    .feature-num{font:10px var(--mono);color:var(--accent)}
    .feature h3{font-size:16px;letter-spacing:-.04em;margin:0 0 4px}
    .feature p{color:#85847e;font-size:11px;line-height:1.6;margin:0}
    .feature-mark{font:15px var(--mono);color:#66655f}

    /* Story */
    .story{padding-top:45px}
    .story-panel{position:relative;overflow:hidden;background:var(--accent);color:#160e0b;padding:clamp(40px,7vw,96px);min-height:500px;display:flex;flex-direction:column;justify-content:space-between}
    .story-panel::before{content:"S";position:absolute;right:-.04em;bottom:-.42em;font-size:clamp(240px,44vw,610px);font-weight:800;letter-spacing:-.13em;line-height:1;color:rgba(18,12,10,.07);pointer-events:none}
    .story-top{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:20px;font:10px var(--mono);letter-spacing:.14em;text-transform:uppercase}
    .story-content{position:relative;z-index:1;max-width:910px;margin:72px 0 58px}
    .story-content h2{font-size:clamp(50px,9vw,130px);line-height:.84;max-width:960px}
    .story-content h2 span{color:rgba(22,14,11,.48)}
    .story-bottom{position:relative;z-index:1;display:flex;align-items:end;justify-content:space-between;gap:35px}
    .story-bottom p{font-size:13px;line-height:1.8;max-width:330px;margin:0}
    .story-bottom .button{background:#171311;color:#f4f2ed;border-color:#171311}
    .story-bottom .button:hover{background:transparent;color:#171311}

    /* Contact / footer */
    .contact{padding-bottom:70px}
    .contact-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end;padding-bottom:75px;border-bottom:1px solid var(--line)}
    .contact h2{font-size:clamp(54px,8.8vw,122px);margin-bottom:24px}
    .contact .body-copy{margin-bottom:0}
    .signup{border-bottom:1px solid #74736d;display:flex;align-items:center;gap:15px;padding:13px 0}
    .signup input{min-width:0;width:100%;outline:none;border:0;background:transparent;color:var(--ink);font-size:14px;padding:10px 0}
    .signup input::placeholder{color:#777670}
    .signup button{width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border:1px solid var(--accent);background:var(--accent);color:#111;cursor:pointer;font-size:20px;transition:background .2s,color .2s}
    .signup button:hover{background:transparent;color:var(--accent)}
    .signup-note{font:10px/1.6 var(--mono);color:#777670;margin-top:14px;letter-spacing:.04em}
    .footer{padding-top:35px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap}
    .footer-brand{display:flex;align-items:center;gap:12px}
    .footer .brand{font-size:24px}
    .footer-copy,.footer-links{font:10px var(--mono);letter-spacing:.09em;text-transform:uppercase;color:#777670}
    .footer-links{display:flex;gap:24px}.footer-links a:hover{color:var(--ink)}
    .toast{position:fixed;right:24px;bottom:24px;z-index:500;background:#242321;border:1px solid rgba(255,255,255,.15);padding:16px 20px;display:flex;align-items:center;gap:12px;max-width:min(400px,calc(100% - 48px));box-shadow:0 12px 40px rgba(0,0,0,.35);transform:translateY(130%);opacity:0;transition:transform .35s var(--ease),opacity .35s ease;font-size:12px;color:#f0eee8}
    .toast.show{transform:translateY(0);opacity:1}.toast-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);flex:0 0 8px}

    /* Scroll reveals: only opacity and transform for smooth, cheap animation */
    .reveal{opacity:0;transform:translateY(28px);transition:opacity .75s var(--ease),transform .75s var(--ease);will-change:opacity,transform}
    .reveal.is-visible{opacity:1;transform:translateY(0)}
    .reveal[data-delay="1"]{transition-delay:.1s}.reveal[data-delay="2"]{transition-delay:.2s}.reveal[data-delay="3"]{transition-delay:.3s}
    .reveal-left{opacity:0;transform:translateX(-26px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
    .reveal-left.is-visible{opacity:1;transform:translateX(0)}

    @media (max-width:1050px){
      .container,.nav-inner{width:min(100% - 52px,1440px)}
      .hero-grid{grid-template-columns:minmax(0,1fr) minmax(310px,.9fr);gap:12px}.hero-art{height:min(68vh,620px);margin-right:-5vw}.hero h1{font-size:clamp(62px,8.2vw,100px)}.hero-meta{margin-top:36px}
      .product-image{height:320px}.tech-visual{min-height:530px}.section{padding:105px 0}.story{padding-top:35px}
    }
    @media (max-width:760px){
      :root{--nav-h:70px}.site-nav{height:70px}.container,.nav-inner{width:calc(100% - 36px)}
      .brand{font-size:23px}.nav-actions{gap:12px}.bag-button span:not(.bag-count){display:none}.menu-toggle{display:flex}
      .nav-links{position:absolute;left:0;right:0;top:69px;display:flex;align-items:stretch;flex-direction:column;gap:0;margin:0;padding:8px 18px 20px;background:rgba(16,16,16,.96);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity .25s ease,transform .25s ease,visibility .25s}
      .nav-links.open{opacity:1;visibility:visible;transform:translateY(0)}.nav-links a{padding:16px 4px;border-bottom:1px solid rgba(255,255,255,.07);font-size:11px}.nav-links a::after{display:none}
      .nav-cta{display:none}.hero{height:auto;min-height:100svh;padding:108px 0 102px}.hero-grid{grid-template-columns:1fr;gap:0;min-height:calc(100svh - 210px)}.hero-copy{padding:18px 0 0;max-width:620px}.hero .eyebrow{margin-bottom:22px;font-size:9px}.hero h1{font-size:clamp(52px,12.3vw,84px);line-height:.84;margin-bottom:23px;white-space:normal}.hero-sub{display:block}.hero-sub p{max-width:310px;font-size:12px}.hero-links{margin-top:22px}.hero-meta{margin-top:30px;max-width:none;gap:10px;font-size:8px}.hero-art{position:absolute;top:22px;right:-20vw;width:94vw;height:57vh;min-height:0;margin:0;opacity:.57;z-index:1;pointer-events:none}.hero-orbit{width:83vw}.hero-disc{width:73%}.hero-shoe-wrap{width:100%;max-width:570px}.hero-tag,.hero-stamp{display:none}.scroll-cue{bottom:20px}
      .section{padding:82px 0}.section-head{display:block;margin-bottom:30px}.section-head h2{margin-bottom:22px}.collection-intro{max-width:340px}.product-grid{grid-template-columns:1fr;gap:13px}.product-card{display:grid;grid-template-columns:44% 56%;min-height:235px}.product-image{height:100%;min-height:235px}.product-info{padding:20px 15px 15px;display:flex;flex-direction:column;justify-content:space-between}.product-title{font-size:19px}.product-price{font-size:11px}.product-title-row{gap:8px}.product-bottom{margin-top:18px;padding-top:12px;align-items:flex-start;flex-direction:column}.product-tag{font-size:8px;right:8px;top:8px;padding:6px}.product-index{top:10px;left:10px;font-size:8px}.collection-foot{align-items:flex-start;gap:18px;flex-direction:column;margin-top:22px}
      .tech-grid{grid-template-columns:1fr;gap:38px}.tech-visual{min-height:420px;grid-row:2}.tech-copy h2{max-width:520px}.tech-copy .body-copy{font-size:13px}.feature-list{margin-top:31px}.feature{grid-template-columns:32px 1fr auto;gap:12px}
      .story{padding-top:12px}.story-panel{padding:30px 24px;min-height:440px}.story-top{font-size:8px;align-items:flex-start}.story-content{margin:72px 0 66px}.story-content h2{font-size:clamp(52px,12vw,88px)}.story-bottom{align-items:flex-start;flex-direction:column;gap:23px}.story-bottom p{font-size:12px}.contact-grid{grid-template-columns:1fr;gap:40px;padding-bottom:45px}.contact h2{font-size:clamp(58px,13vw,96px)}.footer{align-items:flex-start}.footer-copy{order:3;width:100%}.footer-links{gap:15px;font-size:9px}
    }
    @media (max-width:390px){.container,.nav-inner{width:calc(100% - 28px)}.hero h1{font-size:clamp(47px,12.3vw,58px)}.hero-art{right:-23vw;width:100vw;height:53vh}.hero-meta{font-size:7px}.product-card{grid-template-columns:42% 58%}.product-image{min-height:220px}.product-info{padding:16px 12px 12px}.product-title{font-size:17px}.product-price{font-size:10px}.product-type{font-size:8px}}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.reveal,.reveal-left{opacity:1;transform:none;will-change:auto}}
  </style>
</head>
<body>
  <div class="page-progress" aria-hidden="true"></div>
  <header class="site-nav" id="siteNav">
    <nav class="nav-inner" aria-label="Main navigation">
      <a class="brand" href="#top" aria-label="SUNS home"><span class="brand-mark" aria-hidden="true"></span><span>SUNS<span style="color:var(--accent)">®</span></span></a>
      <div class="nav-links" id="navLinks">
        <a href="#collection">Collection</a>
        <a href="#technology">Technology</a>
        <a href="#story">Our story</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="nav-actions">
        <button class="bag-button" type="button" id="bagButton" aria-label="Shopping bag, 0 items">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
          <span>Bag</span><span class="bag-count" id="bagCount">0</span>
        </button>
        <a class="button nav-cta" href="#collection" style="min-height:42px;padding:0 15px;font-size:9px">Shop the drop <span class="arrow">↗</span></a>
        <button class="menu-toggle" id="menuToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        </button>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="heroTitle">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow reveal">Premium sneakers <span aria-hidden="true">/</span> Drop 001</div>
          <h1 id="heroTitle" class="reveal" data-delay="1">BUILT FOR<br><span class="accent">MORE.</span></h1>
          <div class="hero-sub reveal" data-delay="2">
            <p>Performance meets style. SUNS creates premium sneakers for people who move differently — from the first step to the last light.</p>
          </div>
          <div class="hero-links reveal" data-delay="3">
            <a class="button" href="#collection">Explore the collection <span class="arrow">↗</span></a>
          </div>
          <div class="hero-meta reveal" data-delay="3"><span>Drop 001 <strong>/ Solar system</strong></span><span>Designed for motion</span></div>
        </div>
        <div class="hero-art" aria-label="Featured SUNS three-dimensional sneaker visual">
          <div class="hero-orbit" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
          <div class="hero-shoe-wrap">
            <img class="hero-shoe" src="data:image/png;base64," alt="Sculptural black SUNS sneaker with orange detailing, floating in a studio render" fetchpriority="high" decoding="async" width="680" height="675">
          </div>
          <div class="hero-tag">S-01 / Movement study</div>
          <div class="hero-stamp"><div>Engineered<br>for <b>motion</b>®<br>Since day one</div></div>
        </div>
      </div>
      <a class="scroll-cue" href="#collection" aria-label="Scroll to explore the collection">
        <span class="scroll-cue-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v15M6 13l6 6 6-6"/></svg></span>
        <span class="scroll-cue-text">Scroll to explore</span>
      </a>
    </section>

    <div class="marquee" aria-label="SUNS brand philosophy">
      <div class="marquee-track" aria-hidden="true">
        <div class="marquee-item">Move with intent <i>✳</i> Find your tempo <i>✳</i> Go beyond ordinary <i>✳</i> Move with intent <i>✳</i> Find your tempo <i>✳</i> Go beyond ordinary <i>✳</i></div>
        <div class="marquee-item">Move with intent <i>✳</i> Find your tempo <i>✳</i> Go beyond ordinary <i>✳</i> Move with intent <i>✳</i> Find your tempo <i>✳</i> Go beyond ordinary <i>✳</i></div>
      </div>
    </div>

    <section class="section collection" id="collection" aria-labelledby="collectionTitle">
      <div class="container">
        <div class="section-head reveal">
          <div><div class="section-kicker">001 / The rotation</div><h2 id="collectionTitle">FIND YOUR<br>FREQUENCY.</h2></div>
          <p class="collection-intro">Three silhouettes. One point of view. Considered materials made for everyday miles and after-hours plans.</p>
        </div>
        <div class="product-grid">
          <article class="product-card reveal" data-delay="1">
            <div class="product-image"><span class="product-index">SUNS / 001</span><span class="product-tag">New drop</span><img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=900&q=85" alt="Red sneaker, Solar-01 colorway" loading="lazy"></div>
            <div class="product-info"><div class="product-title-row"><div><h3 class="product-title">Solar-01</h3><div class="product-type">The everyday runner</div></div><div class="product-price">$145</div></div><div class="product-bottom"><div class="swatches" aria-label="Available colors"><span class="swatch swatch--orange"></span><span class="swatch swatch--black"></span><span class="swatch swatch--cream"></span></div><button class="quick-add" data-product="Solar-01" type="button">Quick add <span>↗</span></button></div></div>
          </article>
          <article class="product-card reveal" data-delay="2">
            <div class="product-image"><span class="product-index">SUNS / 002</span><img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?auto=format&fit=crop&w=900&q=85" alt="Minimal light-colored sneaker, Daybreak colorway" loading="lazy"></div>
            <div class="product-info"><div class="product-title-row"><div><h3 class="product-title">Daybreak</h3><div class="product-type">The all-day essential</div></div><div class="product-price">$130</div></div><div class="product-bottom"><div class="swatches" aria-label="Available colors"><span class="swatch swatch--cream"></span><span class="swatch swatch--black"></span><span class="swatch swatch--blue"></span></div><button class="quick-add" data-product="Daybreak" type="button">Quick add <span>↗</span></button></div></div>
          </article>
          <article class="product-card reveal" data-delay="3">
            <div class="product-image"><span class="product-index">SUNS / 003</span><img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=900&q=85" alt="Sculptural performance sneaker, Nightshift colorway" loading="lazy"></div>
            <div class="product-info"><div class="product-title-row"><div><h3 class="product-title">Nightshift</h3><div class="product-type">The after-hours pace</div></div><div class="product-price">$160</div></div><div class="product-bottom"><div class="swatches" aria-label="Available colors"><span class="swatch swatch--black"></span><span class="swatch swatch--blue"></span><span class="swatch swatch--orange"></span></div><button class="quick-add" data-product="Nightshift" type="button">Quick add <span>↗</span></button></div></div>
          </article>
        </div>
        <div class="collection-foot reveal"><span>Thoughtfully made. Ready for real life.</span><a class="text-link" href="#contact">Get drop updates <span>↗</span></a></div>
      </div>
    </section>

    <section class="section technology" id="technology" aria-labelledby="technologyTitle">
      <div class="container tech-grid">
        <div class="tech-visual reveal-left">
          <span class="tech-number">FIG. 01 — SOLE / UPPER / FORM</span>
          <img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=1200&q=85" alt="Close detail of sneaker construction and sole geometry" loading="lazy">
          <div class="tech-caption"><b>LESS NOISE.<br>MORE FEEL.</b><span>Built in layers<br>Designed to disappear</span></div>
        </div>
        <div class="tech-copy reveal">
          <div class="section-kicker">002 / Thoughtful by design</div>
          <h2 id="technologyTitle">MADE TO<br>MOVE YOU.</h2>
          <p class="body-copy">Good design doesn't ask for attention. It earns your trust over a thousand small moments — the fit, the flex, the way your feet feel at the end of a long day.</p>
          <a class="text-link" href="#story">The SUNS standard <span>↗</span></a>
          <div class="feature-list">
            <div class="feature"><span class="feature-num">01</span><div><h3>Adaptive comfort</h3><p>A balanced ride, shaped around natural movement.</p></div><span class="feature-mark">↗</span></div>
            <div class="feature"><span class="feature-num">02</span><div><h3>Purposeful materials</h3><p>Durable, breathable textiles chosen for the long run.</p></div><span class="feature-mark">↗</span></div>
            <div class="feature"><span class="feature-num">03</span><div><h3>Stripped-back form</h3><p>Clean lines. No extra. Nothing to get in your way.</p></div><span class="feature-mark">↗</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section story" id="story" aria-labelledby="storyTitle">
      <div class="container">
        <div class="story-panel reveal">
          <div class="story-top"><span>003 / Why we exist</span><span>Independent by nature · Human by design</span></div>
          <div class="story-content"><h2 id="storyTitle">YOUR PACE.<br><span>YOUR PATH.</span><br>YOUR SUNS.</h2></div>
          <div class="story-bottom"><p>We believe the best things happen when you stop chasing someone else's finish line. SUNS is footwear for moving through the world on your own terms.</p><a class="button" href="#contact">Come along <span class="arrow">↗</span></a></div>
        </div>
      </div>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contactTitle">
      <div class="container">
        <div class="contact-grid">
          <div class="reveal"><div class="section-kicker">004 / Stay in the loop</div><h2 id="contactTitle">NEXT UP.<br>SOON.</h2><p class="body-copy">New drops, small runs, and things worth knowing. No noise in your inbox — just the good stuff.</p></div>
          <div class="reveal" data-delay="1"><form id="signupForm"><label class="eyebrow" for="emailInput" style="margin-bottom:20px">The SUNS dispatch</label><div class="signup"><input id="emailInput" name="email" type="email" placeholder="Your email address" required autocomplete="email"><button type="submit" aria-label="Subscribe">↗</button></div><p class="signup-note">By signing up, you agree to receive occasional SUNS updates. Unsubscribe any time.</p></form></div>
        </div>
        <footer class="footer">
          <div class="footer-brand"><a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"></span><span>SUNS<span style="color:var(--accent)">®</span></span></a></div>
          <div class="footer-copy">© 2026 SUNS Footwear Studio</div>
          <div class="footer-links"><a href="#collection">Shop</a><a href="#technology">Materials</a><a href="#contact">Instagram ↗</a></div>
        </footer>
      </div>
    </section>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"><span class="toast-dot"></span><span id="toastMessage">You're on the list.</span></div>

  <script>
    (() => {
      const nav = document.getElementById('siteNav');
      const navLinks = document.getElementById('navLinks');
      const menuToggle = document.getElementById('menuToggle');
      const progress = document.querySelector('.page-progress');
      const bagCount = document.getElementById('bagCount');
      const bagButton = document.getElementById('bagButton');
      const toast = document.getElementById('toast');
      const toastMessage = document.getElementById('toastMessage');
      let bagItems = 0;
      let toastTimer;

      function showToast(message) {
        toastMessage.textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 2900);
      }
      function updateScrollUI() {
        nav.classList.toggle('is-scrolled', window.scrollY > 18);
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = (maxScroll > 0 ? Math.min(100, window.scrollY / maxScroll * 100) : 0) + '%';
      }
      updateScrollUI();
      window.addEventListener('scroll', updateScrollUI, { passive: true });
      window.addEventListener('resize', updateScrollUI, { passive: true });

      menuToggle.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
        menuToggle.innerHTML = isOpen
          ? '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>'
          : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>';
      });
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.setAttribute('aria-label', 'Open menu');
          menuToggle.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>';
        });
      });

      // Reveal only when content enters the viewport; use a single observer for performance.
      const revealItems = document.querySelectorAll('.reveal, .reveal-left');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.14, rootMargin: '0px 0px -42px 0px' });
        revealItems.forEach(item => revealObserver.observe(item));
      } else {
        revealItems.forEach(item => item.classList.add('is-visible'));
      }

      // Track which section is being viewed and highlight its matching navigation link.
      const sections = ['collection', 'technology', 'story', 'contact'].map(id => document.getElementById(id));
      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              navLinks.querySelectorAll('a').forEach(link => link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id));
            }
          });
        }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
        sections.forEach(section => section && sectionObserver.observe(section));
      }

      document.querySelectorAll('.quick-add').forEach(button => {
        button.addEventListener('click', () => {
          bagItems += 1;
          bagCount.textContent = bagItems;
          bagButton.setAttribute('aria-label', `Shopping bag, ${bagItems} item${bagItems === 1 ? '' : 's'}`);
          showToast(`${button.dataset.product} added to your bag · ${bagItems} item${bagItems === 1 ? '' : 's'} total`);
        });
      });
      bagButton.addEventListener('click', () => showToast(bagItems ? `Your bag has ${bagItems} item${bagItems === 1 ? '' : 's'} — checkout demo only.` : 'Your bag is empty. Find your frequency in the collection.'));

      document.getElementById('signupForm').addEventListener('submit', event => {
        event.preventDefault();
        const input = document.getElementById('emailInput');
        if (!input.checkValidity()) { input.reportValidity(); return; }
        showToast('You’re on the SUNS dispatch list. Stay in motion.');
        event.currentTarget.reset();
      });

      // Graceful image fallback preserves the designed frame if a remote asset is unavailable.
      document.querySelectorAll('img').forEach(img => {
        img.addEventListener('error', () => {
          img.style.opacity = '0';
          img.parentElement.classList.add('image-unavailable');
        }, { once: true });
      });
    })();
  </script>
</body>
</html>
